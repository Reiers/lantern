# Curio-PDP (skiff) .env for running against Lantern instead of Forest.
#
# Copy over the upstream file in curio/docker/skiff:
#   cp .env .env.upstream
#   cp /path/to/lantern/deploy/curio-pdp/env.lantern.example .env
# then replace every <placeholder>. Walkthrough: RUN-PDP.md.
# Needs Lantern v1.10.1 or later (earlier releases cannot serve Curio-PDP
# after the NV29 network upgrade).

# Published Curio-PDP image for calibration (mainnet: filecoin/curio-pdp:latest).
SKIFF_IMAGE=filecoin/curio-pdp:calibnet

# Only used when building the image locally; ignored with --no-build.
SKIFF_MAKE_TARGET=calibnet-skiff

# Yugabyte image (same as upstream).
YUGABYTE_IMAGE=yugabytedb/yugabyte:2024.1.0.0-b129

# Host paths. Keep YUGABYTE_DATA and SKIFF_REPO_DATA on fast disk (NVMe/SSD).
# SKIFF_STORAGE is mounted in the container at /data; piece files go there and
# it may be slow disk.
YUGABYTE_DATA=./data/yugabyte
SKIFF_REPO_DATA=./data/skiff
SKIFF_STORAGE=./data

# Public hostname of your PDP API, without scheme (for example pdp.example.com).
# Set this BEFORE the first start: it is seeded into the base config layer
# (HTTP.DomainName) only once. Leaving it at "localhost" means you must edit
# HTTP.DomainName later in the admin GUI config editor and restart skiff.
SKIFF_HTTP_DOMAIN=<your-pdp-hostname>

# Lantern's admin token and RPC address. The token authenticates Curio for
# write / sign methods (sending its transactions); keep .env private.
# Printed by:
#   lantern info --network calibration
# The address must be an IP literal the container can reach: the docker0
# bridge IP Lantern listens on (usually 172.17.0.1).
# Do NOT use /ip4/host.docker.internal/...: /ip4 needs an IP literal and
# Curio crash-loops with "unknown url scheme ''".
FULLNODE_API_INFO=<lantern-admin-token>:/ip4/172.17.0.1/tcp/1234/http
